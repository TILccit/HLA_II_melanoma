surv_analysis_tcga <- function(
    project,
    up_list,
    down_list,
    gdc_root = "E:/PhD_projects/MHCII_project/TCGA_all/GDCdata")
 { 
  suppressPackageStartupMessages({
    library(TCGAbiolinks)
    library(SummarizedExperiment)
    library(edgeR)
    library(AnnotationDbi)
    library(org.Hs.eg.db)
    library(singscore)
    library(dplyr)
    library(survival)
  })
  setwd("E:/PhD_projects/MHCII_project/Paper/Clean_scripts/")

  query <- GDCquery(project = project,
                  data.category = "Transcriptome Profiling",
                  data.type     = "Gene Expression Quantification",
                  workflow.type = "STAR - Counts")
  if(dir.exists(file.path("GDCdata", project))){
    data_se <- GDCprepare(
      query, 
      directory = "GDCdata"
    )
  } else {
    GDCdownload(query)
    data_se <- GDCprepare(query)
  }
  
  expr  <- assay(data_se)               # sample × gene counts
  clin  <- colData(data_se)  
  counts = expr
  
  # Remove Ensembl version suffix (e.g. ENSG000001234.5 → ENSG000001234)
  rownames(counts) <- sub("\\..*$", "", rownames(counts))
  
  # 4) Retrieve gene lengths (median transcript length per gene) from Ensembl
  ensembl <- useMart("ensembl", dataset="hsapiens_gene_ensembl")
  geneAnnot <- getBM(
    attributes = c("ensembl_gene_id", "transcript_length"),
    filters    = "ensembl_gene_id",
    values     = rownames(counts),
    mart       = ensembl
    )
  # compute median transcript length
  library(dplyr)
  geneLengths <- geneAnnot %>%
    group_by(ensembl_gene_id) %>%
    summarise(median_length = median(transcript_length)) %>%
    ungroup()
  
  # match lengths to your count matrix
  length.kb <- geneLengths$median_length[match(rownames(counts),
                                               geneLengths$ensembl_gene_id)] / 1000
  
  # 5) Create DGEList and calculate normalization factors
  dge <- DGEList(counts = counts, genes = data.frame(Length = length.kb))
  dge <- calcNormFactors(dge)  # TMM normalization
  
  # 6) Compute FPKM
  fpkm.mat <- rpkm(dge,
                 gene.length        = dge$genes$Length,
                 normalized.lib.sizes = TRUE)
  
  library(org.Hs.eg.db)
  library(AnnotationDbi)


  # 2. Map IDs
  hugo <- mapIds(
    org.Hs.eg.db,
    keys      = rownames(fpkm.mat),
    column    = "SYMBOL",
    keytype   = "ENSEMBL",
    multiVals = "first"
  )

  # 3. Subset out NAs and rename
  keep <- !is.na(hugo)
  expr_hugo_rcc <- fpkm.mat[keep, , drop=FALSE]
  rownames(expr_hugo_rcc) <- hugo[keep]

  rank_data <- rankGenes(expr_hugo_rcc)

  md <- colData(data_se)
  md$sample <- rownames(md)
  md <- merge(x = clinical_data,y = md, by.x = "bcr_patient_barcode", by.y = "patient")
  # compute simple singscore
  scores <- simpleScore(rank_data,
                        upSet   = up_list,
                        downSet = down_list)
  #rownames(scores) <- gsub(x= rownames(scores), pattern = "\\.", replacement = "-")
  scores$sample <- rownames(scores)
  scores <- subset(scores, sample %in% md$sample)
  md <- subset(md, sample %in% scores$sample)
  scores <- scores[order(scores$sample, md$sample),]

  # assuming rownames are your sample IDs:
  md$signature_score <- scores$TotalScore[
    match(md$sample, scores$sample)
  ]

  # Check they all matched:
  stopifnot(!any(is.na(md$signature_score)))

  #####Administrative censoring KIRC######
  #administrative censoring at 15 years
  md$OS.years <- md$OS.time/365
  md$OS.years_censored   <- pmin(md$OS.years, 15)
  md$OS_censored <- ifelse(md$OS.years > 15, 0, md$OS)
  #Administrative censoring at 60 months
  md$PFI.years <- md$PFI.time/365
  md$PFI.years_censored   <- pmin(md$PFI.years, 15)
  md$PFI_censored <- ifelse(md$PFI.years > 15, 0, md$PFI)

  cat(paste0("Administrative censoring: ", round((length(which(md$OS.years > 15))/length(md$OS.years))*100), "%"))

  message("Running univariate analysis for ", project)
  # 3) Define your group (you already have this)
  md <- as.data.frame(md) %>%
   dplyr::mutate(group = if_else(signature_score >= 
                                   quantile(signature_score, 0.75),
                                  "High","Low"))
  md$group <- factor(md$group, levels = c("Low", "High"))
  # 4) Fit the survival model in one go, using the data frame
  fit <- survfit(
    Surv(OS.years_censored, OS_censored) ~ group,
   data = md
  )

  # 5) Plot
  surv_plot <-ggsurvplot(
    fit,
    data       = md,
    pval       = TRUE,
    risk.table = TRUE
  )

  cox <- coxph(Surv(OS.years_censored, OS_censored) ~ group, data = md)
  s   <- summary(cox)
  
  out <- data.frame(
    project = project,
    n       = nrow(md),
    events  = sum(md$OS_censored, na.rm = TRUE),
    HR      = unname(s$coef["groupHigh", "exp(coef)"]),
    LCL     = unname(s$conf.int["groupHigh", "lower .95"]),
    UCL     = unname(s$conf.int["groupHigh", "upper .95"]),
    p       = unname(s$coef["groupHigh", "Pr(>|z|)"])
  )
  
  return(list(
    project = project,
    meta    = md,
    cox     = out,
    plot    = surv_plot
  ))
  
}

