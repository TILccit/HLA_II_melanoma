# Function to compute HR/CI/p for beta_score + beta_int (or beta_score alone)
get_effect <- function(proj, dat = minimal_all_filt) {
  proj <- as.character(proj)
  
  d <- dat %>% dplyr::filter(project == proj)
  if (nrow(d) == 0) {
    return(tibble::tibble(project = proj, n = 0, events = 0,
                          HR = NA_real_, se = NA_real_, z = NA_real_, p = NA_real_,
                          error = "no rows in project"))
  }
  
  # --- normalization step (within-project z-score) ---
  mu <- mean(d$signature_score, na.rm = TRUE)
  sdv <- stats::sd(d$signature_score, na.rm = TRUE)
  if (!is.finite(sdv) || sdv == 0) {
    return(tibble::tibble(project = proj, n = nrow(d),
                          events = sum(d$event_cens == 1L, na.rm = TRUE),
                          HR = NA_real_, se = NA_real_, z = NA_real_, p = NA_real_,
                          error = "signature_score SD is 0/NA in this project"))
  }
  d <- d %>% dplyr::mutate(signature_z = (signature_score - mu) / sdv)
  
  # enforce complete-case for model variables
  model_vars <- c("time_years_cens","event_cens","signature_z","age_group","sex","stage_group")
  d_cc <- d %>% dplyr::filter(stats::complete.cases(dplyr::across(dplyr::all_of(model_vars))))
  
  n_cc <- nrow(d_cc)
  events <- sum(d_cc$event_cens == 1L, na.rm = TRUE)
  
  if (n_cc == 0) {
    return(tibble::tibble(project = proj, n = 0, events = 0,
                          HR = NA_real_, se = NA_real_, z = NA_real_, p = NA_real_,
                          error = "no complete-case observations"))
  }
  if (events < 5) {
    return(tibble::tibble(project = proj, n = n_cc, events = events,
                          HR = NA_real_, se = NA_real_, z = NA_real_, p = NA_real_,
                          error = "too few events for multivariable Cox"))
  }
  
  # drop covariates with no variation in this project
  fml_terms <- c("signature_z")
  if (dplyr::n_distinct(d_cc$age_group)   > 1) fml_terms <- c(fml_terms, "age_group")
  if (dplyr::n_distinct(d_cc$sex)         > 1) fml_terms <- c(fml_terms, "sex")
  if (dplyr::n_distinct(d_cc$stage_group) > 1) fml_terms <- c(fml_terms, "stage_group")
  
  fml <- as.formula(paste0(
    "survival::Surv(time_years_cens, event_cens) ~ ",
    paste(fml_terms, collapse = " + ")
  ))
  
  tryCatch({
    fit <- survival::coxph(fml, data = d_cc)
    sm <- summary(fit)
    
    idx <- which(rownames(sm$coef) == "signature_z")
    if (length(idx) != 1L) stop("signature_z term not found")
    
    tibble::tibble(
      project = proj,
      n = n_cc,
      events = events,
      HR = unname(sm$coef[idx, "exp(coef)"]),
      se = unname(sm$coef[idx, "se(coef)"]),
      z  = unname(sm$coef[idx, "z"]),
      p  = unname(sm$coef[idx, "Pr(>|z|)"]),
      error = NA_character_
    )
  }, error = function(e) {
    tibble::tibble(
      project = proj, n = n_cc, events = events,
      HR = NA_real_, se = NA_real_, z = NA_real_, p = NA_real_,
      error = paste0("coxph error: ", conditionMessage(e))
    )
  })
}



