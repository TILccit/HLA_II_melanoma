pick_first <- function(df, candidates) {
  hit <- intersect(candidates, names(df))
  if (length(hit) == 0) return(rep(NA, nrow(df)))
  df[[hit[1]]]
}

as_num <- function(x) suppressWarnings(as.numeric(if (is.factor(x)) as.character(x) else x))
as_int01 <- function(x) {
  x <- if (is.factor(x)) as.character(x) else x
  suppressWarnings(as.integer(x))
}

extract_minimal <- function(obj, project) {
  if (inherits(obj, "error") || is.null(obj$meta)) return(NULL)
  
  md <- as.data.frame(obj$meta)
  md[] <- lapply(md, function(x) if (is.factor(x)) as.character(x) else x)
  
  stage_vec <- pick_first(md, c("ajcc_clinical_stage", "ajcc_pathologic_tumor_stage"))
  stage_vec <- as.character(stage_vec)  # force vector
  
  out <- data.frame(
    project = project,
    histology = sub("^TCGA-", "", project),
    sample = pick_first(md, c("sample", "barcode", "submitter_id", "bcr_patient_barcode")),
    signature_score = as_num(pick_first(md, c("signature_score", "score", "TotalScore"))),
    age = as_num(pick_first(md, c("age_at_diagnosis"))),
    sex = pick_first(md, "gender.x"),
    stage = stage_vec,
    time_days = as_num(pick_first(md, c("OS.years_censored", "os.time", "OS_time",
                                        "days_to_death", "days_to_last_follow_up"))),
    event = as_int01(pick_first(md, c("OS_censored", "os", "vital_status_event", "event"))),
    stringsAsFactors = FALSE
  )
  
  out <- out %>%
    mutate(
      stage_group = case_when(
        stage %in% c("Stage 0", "I/II NOS", "Stage I","Stage IA","Stage IB",
                     "Stage II","Stage IIA","Stage IIB","Stage IIC") ~ "0/I/II",
        stage %in% c("Stage III","Stage IIIA","Stage IIIB","Stage IIIC") ~ "III",
        stage == "Stage IV" ~ "IV",
        TRUE ~ NA_character_
      )
    ) %>%
    filter(!is.na(sample), !is.na(signature_score), !is.na(time_days), !is.na(event)) %>%
    mutate(
      age_group = if_else(!is.na(age) & (age/365) < 40, "<40", "≥40"),
      time_years = time_days / 365,
      time_years_cens = pmin(time_years, 15),
      event_cens = if_else(time_years > 15, 0L, event),
      stage_group = factor(stage_group, levels = c("0/I/II","III","IV")),
      age_group   = factor(age_group,   levels = c("<40","≥40"))
    )
  
  out
}


