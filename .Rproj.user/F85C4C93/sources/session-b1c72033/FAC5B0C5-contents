###CD4 NO IFN#####
setwd("E:/PhD_projects/MHCII_project/CD4flowMP/clear things/Mario/Tables_Mario/double_positives/")
ics_data_cd4_noifn <- read.xlsx("ICS_IFN.xlsx",sheet = "CD4_NO_IFN")
ics_data_cd4_noifn$`TCL33` <- NULL
colnames(ics_data_cd4_noifn)[1] <- "condition"
rownames(ics_data_cd4_noifn) <- gsub(".fcs", "", ics_data_cd4_noifn$condition)
ics_data_cd4_noifn[,"condition"]=NULL

#background removal
alone <- as.numeric(ics_data_cd4_noifn["TILAlone",])
ics_data_cd4_noifn_noback <- sweep(ics_data_cd4_noifn, 2, alone, FUN = "-")
ics_data_cd4_noifn_noback[ics_data_cd4_noifn_noback <= 0] <- 0.001
ics_data_cd4_noifn_noback <- ics_data_cd4_noifn_noback[2:nrow(ics_data_cd4_noifn_noback),]

#remove samples with no reactivity at baseline
ics_data_cd4_noifn_noback <- ics_data_cd4_noifn_noback[,which(ics_data_cd4_noifn_noback[1,]> 0.01)]

#plotting and testing
ics_data_cd4_noifn_noback_plot <- as.data.frame(t(ics_data_cd4_noifn_noback))
ics_data_cd4_noifn_noback_plot$sample <- rownames(ics_data_cd4_noifn_noback_plot)
ics_data_cd4_noifn_noback_plot <- pivot_longer(ics_data_cd4_noifn_noback_plot,cols = !(sample), names_to = "Condition")
ics_data_cd4_noifn_noback_plot$Condition <- factor(ics_data_cd4_noifn_noback_plot$Condition, levels = 
                                                     c(unique(grep("WT", ics_data_cd4_noifn_noback_plot$Condition, value = T)),
                                                       unique(grep("CIITA", ics_data_cd4_noifn_noback_plot$Condition, value = T)),
                                                       unique(grep("DR", ics_data_cd4_noifn_noback_plot$Condition, value = T)),
                                                       unique(grep("DP", ics_data_cd4_noifn_noback_plot$Condition, value = T)),
                                                       unique(grep("DQ", ics_data_cd4_noifn_noback_plot$Condition, value = T))
                                                       ))

ref <- unique(grep("WT", ics_data_cd4_noifn_noback_plot$Condition, value = T))
other_conds <- setdiff(unique(levels(ics_data_cd4_noifn_noback_plot$Condition)), c(ref))
comparisons_noifn <- lapply(other_conds, function(x) c(ref, x))

y_positions_noifn <- seq(from = 0.60 * 50, to = 0.9 * 50, length.out = length(comparisons_noifn))

levels(ics_data_cd4_noifn_noback_plot$Condition) <- sub("TIL\\+Tumor ", "", levels(ics_data_cd4_noifn_noback_plot$Condition))
levels(ics_data_cd4_noifn_noback_plot$Condition) <- sub("KO ", "", levels(ics_data_cd4_noifn_noback_plot$Condition))

comparisons_noifn <- lapply(comparisons_noifn, function(x) sub("TIL\\+Tumor ", "", x))
comparisons_noifn <- lapply(comparisons_noifn, function(x) sub("KO ", "", x))

ggplot(ics_data_cd4_noifn_noback_plot, aes(x = Condition, y = value)) +
  stat_summary(aes(fill=Condition),fun = median, geom = "col", show.legend = FALSE,alpha=0.6) +
  geom_line(aes(group = sample, colour = sample), size = 1, alpha = 0.6) +
  geom_point(size = 2, stroke = 0.5, alpha = 0.8, color="grey10") +
  scale_fill_viridis_d(option = "B", begin = 0.1, end = 0.5) +
  scale_color_viridis_d(option = "B", begin = 0.5, end = 0.9) +
  theme_classic(base_size = 14) +
  theme(
    panel.grid.minor   = element_blank(),
    panel.grid.major.x = element_blank(),
    axis.text.x        = element_text(angle = 45, hjust = 1),
    axis.title.x       = element_blank(),
    legend.position    = "right",
    legend.title       = element_text(face = "bold"),
    plot.title = element_text(hjust = 0.5)
  )+
  stat_compare_means(
    comparisons   = comparisons_noifn,
    method        = "wilcox.test",
    paired        = TRUE,
    p.adjust.method = "fdr",
    label         = "p.adj",
    label.y = y_positions_noifn,
    size          = 5
  )+
  stat_summary(
    aes(label = paste0(sprintf("%.2f", ..y..),"%")),
    fun      = median,
    geom     = "label",           # use labels instead of plain text
    vjust    = -0.5,              # nudge a bit above
    size     = 4,
    fill     = "white",           # white box behind text
    colour   = "black",
    label.padding = unit(0.2, "lines"),  # more breathing room
    label.r       = unit(0.15, "lines")  # slightly rounded corners
  ) +
  scale_y_continuous(limits = c(0,50))+
  labs(
    title = "CD4+ TIL reactivity (No IFN)",
    x     = NULL,
    y     = "% of reactive CD4+ TILs"
  )



