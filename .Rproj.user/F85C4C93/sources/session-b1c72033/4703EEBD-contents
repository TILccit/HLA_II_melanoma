library(tidyverse)

df <- fread("E:/PhD_projects/MHCII_project/CD4flowMP/clear things/Mario/KO_validation//KO_validation_HLA.txt")

names(df)[1] <- "Sample"

library(tidyverse)

names(df)[1] <- "Sample"

plot_df <- df %>%
  filter(!Sample %in% c("Mean", "SD")) %>%
  pivot_longer(
    cols = -Sample,
    names_to = "Marker_raw",
    values_to = "MFI"
  ) %>%
  mutate(
    MFI = as.numeric(as.character(MFI)),
    
    Marker = case_when(
      str_detect(Marker_raw, "HLA-DR") ~ "HLA-DR",
      str_detect(Marker_raw, "HLA-DP") ~ "HLA-DP",
      str_detect(Marker_raw, "HLA-DQ") ~ "HLA-DQ",
      TRUE ~ Marker_raw
    ),
    
    Sample_clean = str_remove(Sample, "\\.fcs$"),
    Cell_line = str_extract(Sample_clean, "^MM\\d+\\.\\d+"),
    
    Sample_stub = Sample_clean %>%
      str_remove("^MM\\d+\\.\\d+\\s*"),
    
    IFNg = str_detect(Sample_stub, "\\+IFNg"),
    Isotype = str_detect(Sample_stub, "^Iso"),
    
    Clone_tag = str_match(
      Sample_stub,
      "^(?:Iso_?|\\+IFNg_)?([A-Z]\\d)(?=_)"
    )[, 2],
    
    Genotype_raw = Sample_stub %>%
      str_remove("^Iso_?") %>%
      str_remove("^\\+IFNg_?") %>%
      str_remove("\\+IFNg$") %>%
      str_remove("^[A-Z]\\d_") %>%
      str_replace_all("_", " ") %>%
      str_squish(),
    
    Genotype = case_when(
      str_detect(Genotype_raw, "^WT$") ~ "WT",
      str_detect(Genotype_raw, "CIITA KO") ~ "CIITA KO",
      str_detect(Genotype_raw, "HLA-DR KO") ~ "HLA-DR KO",
      str_detect(Genotype_raw, "HLA-DP KO") ~ "HLA-DP KO",
      str_detect(Genotype_raw, "HLA-DQ-?KO") ~ "HLA-DQ KO",
      TRUE ~ Genotype_raw
    )
  )

ifng_df <- plot_df %>%
  filter(IFNg)

iso_ref <- ifng_df %>%
  filter(Isotype) %>%
  mutate(
    # Prefer the generic Iso_WT+IFNg reference if more than one isotype exists
    untagged_isotype = is.na(Clone_tag)
  ) %>%
  arrange(Cell_line, Marker, desc(untagged_isotype)) %>%
  group_by(Cell_line, Marker) %>%
  slice(1) %>%
  ungroup() %>%
  select(
    Cell_line,
    Marker,
    Iso_MFI = MFI,
    Iso_sample = Sample_clean
  )

ifng_corrected <- ifng_df %>%
  filter(!Isotype) %>%
  left_join(
    iso_ref,
    by = c("Cell_line", "Marker")
  ) %>%
  mutate(
    Delta_MFI = MFI - Iso_MFI,
    log2FC_vs_isotype = log2((MFI + 1) / (Iso_MFI + 1)),
    
    Genotype = factor(
      Genotype,
      levels = c(
        "WT",
        "CIITA KO",
        "HLA-DR KO",
        "HLA-DP KO",
        "HLA-DQ KO"
      )
    ),
    
    Marker = factor(
      Marker,
      levels = c("HLA-DR", "HLA-DP", "HLA-DQ")
    )
  )

marker_cols <- c(
  "HLA-DR" = "#0072B2",  # blue
  "HLA-DP" = "#D55E00",  # vermillion
  "HLA-DQ" = "#009E73"   # green
)

